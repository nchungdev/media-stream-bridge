# Copy to .env (never commit it) and replace every placeholder.

# Listen address. Keep 127.0.0.1 and put a reverse proxy in front if needed.
MSB_LISTEN_HOST=127.0.0.1
MSB_PORT=6890

# qBittorrent-compatible login used by Sonarr/Radarr (password >= 12 chars, not "admin").
MSB_QBIT_USERNAME=change-me
MSB_QBIT_PASSWORD=change-me-to-a-long-random-password

# Torznab API key used by Prowlarr/Sonarr/Radarr (>= 24 chars).
MSB_API_KEY=change-me-to-a-random-key-of-24-chars-or-more

# Optional tuning.
MSB_MAX_JOBS=200
MSB_PUBLIC_URL=http://127.0.0.1:6890
MSB_EPISODE_TIMEOUT=3h
